# Copie este arquivo para .env e preencha. O .env nunca vai para o GitHub.
# Quem configura pelo Claude Code ou Codex não precisa mexer aqui: o assistente preenche sozinho.

# ── Supabase (Project Settings → API Keys) ──────────────────────────────
# Endereço do projeto: https://<ref>.supabase.co
SUPABASE_URL=
# Chave pública: "Publishable key" (sb_publishable_...) ou a legada "anon"
SUPABASE_PUBLISHABLE_KEY=
# Chave secreta: "Secret key" (sb_secret_...) ou a legada "service_role".
# Só é usada pelos scripts de administração (npm run usuario:adicionar etc.) e nunca é publicada.
SUPABASE_SERVICE_ROLE_KEY=
# Identificador do projeto (o <ref> do endereço acima)
SUPABASE_PROJECT_ID=
# Senha do banco (opcional; só preenchida quando o assistente cria o projeto)
SUPABASE_DB_PASSWORD=

# As mesmas informações para o navegador (precisam ser iguais às de cima)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ── Inteligência artificial (platform.openai.com → API keys) ────────────
# Sem a chave o sistema funciona, mas sem os recursos de IA.
OPENAI_API_KEY=
# Opcional: modelo da OpenAI usado pelo sistema (padrão: gpt-6-astra)
OPENAI_MODEL=

# ── Publicação ──────────────────────────────────────────────────────────
# Endereço público do sistema depois de publicado (ex.: https://contratacao.suaconta.workers.dev)
APP_URL=
# Opcional: nome do Worker no Cloudflare (padrão: contratacao)
CLOUDFLARE_WORKER_NAME=

# ── Opcional: login com Google ──────────────────────────────────────────
# Só ative depois de ligar o provedor Google no Supabase (Authentication → Sign In / Providers).
VITE_GOOGLE_LOGIN=false
